---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings?: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { title, description, pubDate, updatedDate, tags, headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth > 1 && heading.depth < 4);
---

<BaseLayout title={title} description={description}>
  <article class="post-shell">
    <header class="post-header">
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{pubDate.toLocaleDateString('zh-CN')}</time>
        {
          updatedDate && (
            <span>
              更新于 <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('zh-CN')}</time>
            </span>
          )
        }
      </div>
      <div class="tag-list" aria-label="标签">
        {tags.map((tag) => <a href={`/tags/${tag}/`}>{tag}</a>)}
      </div>
    </header>

    <div class="reader-toolbar" aria-label="阅读设置">
      <div class="toolbar-group" aria-label="正文宽度">
        <button type="button" data-reader-width="default" aria-label="默认宽度" title="默认宽度" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="6" y="4" width="12" height="16" rx="1.5"></rect>
            <path d="M9 8h6M9 12h6M9 16h4"></path>
          </svg>
        </button>
        <button type="button" data-reader-width="wide" aria-label="宽屏阅读" title="宽屏阅读" aria-pressed="true">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
            <path d="M7 9h10M7 12h10M7 15h6"></path>
          </svg>
        </button>
      </div>
      {
        tocHeadings.length > 0 && (
          <div class="toolbar-group" aria-label="目录显示">
            <button type="button" data-toc-visible="true" aria-label="显示目录" title="显示目录" aria-pressed="true">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6h3M4 12h3M4 18h3"></path>
                <path d="M10 6h10M10 12h10M10 18h10"></path>
              </svg>
            </button>
          </div>
        )
      }
    </div>

    <div class="reader-layout">
      <div class="prose markdown-body">
        <slot />
      </div>
      {
        tocHeadings.length > 0 && (
          <aside class="toc" aria-label="目录">
            <div class="toc-header">
              <h2>目录</h2>
              <button type="button" data-toc-visible="false" aria-label="隐藏目录" title="隐藏目录">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
            </div>
            <ol>
              {tocHeadings.map((heading) => (
                <li data-depth={heading.depth}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
  </article>

  <script>
    const root = document.documentElement;
    const widthButtons = Array.from(document.querySelectorAll('[data-reader-width]'));
    const tocButtons = Array.from(document.querySelectorAll('[data-toc-visible]'));

    const setPressed = (buttons: Element[], attr: string, value: string) => {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', button.getAttribute(attr) === value ? 'true' : 'false');
      }
    };

    const setWidth = (mode: string) => {
      root.classList.toggle('reader-wide', mode === 'wide');
      window.localStorage.setItem('reader-width', mode);
      setPressed(widthButtons, 'data-reader-width', mode);
    };

    const setToc = (visible: string) => {
      root.classList.toggle('toc-hidden', visible !== 'true');
      window.localStorage.setItem('toc-visible', visible);
      setPressed(tocButtons, 'data-toc-visible', visible);
    };

    setWidth(window.localStorage.getItem('reader-width') || 'default');
    setToc(window.localStorage.getItem('toc-visible') || 'true');

    for (const button of widthButtons) {
      button.addEventListener('click', () => setWidth(button.getAttribute('data-reader-width') || 'default'));
    }

    for (const button of tocButtons) {
      button.addEventListener('click', () => setToc(button.getAttribute('data-toc-visible') || 'true'));
    }

    for (const pre of Array.from(document.querySelectorAll('.prose pre'))) {
      if (pre.querySelector('.copy-code-button')) continue;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code-button';
      button.setAttribute('aria-label', '复制代码');
      button.setAttribute('title', '复制代码');
      button.innerHTML =
        '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';

      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.textContent || '';
        await navigator.clipboard.writeText(code);
        button.setAttribute('data-copied', 'true');
        window.setTimeout(() => button.removeAttribute('data-copied'), 1200);
      });

      pre.append(button);
    }
  </script>
</BaseLayout>
